--[[
	sfly.lua · Superman Fly implementado con LIBB (prueba de la lib)
	Tecla de fly: X (bind inline en la fila del toggle) · Ocultar UI: RightControl
	Sin apartados: WASD; la altura la marca la mirada de la camara
	(mirar arriba/abajo al avanzar sube/baja, igual que Fly.lua). Sin E/Q.
	Levitacion clavada al reposo (sin float ni ascenso inicial) y muerto
	de 12° en el pitch: volar recto no sube ni baja. Animacion propia al
	retroceder y dropdown con las animaciones del lote oficial de Roblox.
	Fix shiftlock: AutoRotate apagado + cuello (Neck) re-fijado cada frame.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local hrp = character:WaitForChild("HumanoidRootPart")
local originalGravity = Workspace.Gravity

local flying = false
local flySpeed = 120
local moveState = { forward = 0, backward = 0, left = 0, right = 0 }
local currentCF = nil
local currentVelocity = Vector3.zero
local flightConns = {}
local currentAnimTrack = nil

-- pitch muerto (grados): por debajo de esa inclinacion de camara la
-- direccion de avance es plana y NO hay derivo vertical (sin subir/bajar)
local DEAD_PITCH = 12

local function emptyMove()
	return { forward = 0, backward = 0, left = 0, right = 0 }
end

local Controls
pcall(function()
	local PlayerModule = require(player.PlayerScripts:WaitForChild("PlayerModule"))
	Controls = PlayerModule:GetControls()
end)

local function disableAnimate()
	local animate = character:FindFirstChild("Animate")
	if animate then animate.Disabled = true end
end

local function enableAnimate()
	local animate = character:FindFirstChild("Animate")
	if animate then animate.Disabled = false end
end

local function playAnimation(animId, animTime, speed)
	if currentAnimTrack then
		pcall(function() currentAnimTrack:Stop(0.1) end)
		currentAnimTrack = nil
	end
	disableAnimate()
	for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
		pcall(function() track:Stop() end)
	end
	pcall(function()
		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://" .. tostring(animId)
		currentAnimTrack = humanoid:LoadAnimation(anim)
		currentAnimTrack:Play()
		currentAnimTrack.TimePosition = animTime
		currentAnimTrack:AdjustSpeed(speed)
	end)
end

local function stopAnimation()
	if currentAnimTrack then
		pcall(function() currentAnimTrack:Stop(0.1) end)
		currentAnimTrack = nil
	end
	enableAnimate()
	for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
		pcall(function() track:Stop() end)
	end
end

-- animaciones del lote oficial de Roblox (emotes "Emote_*"): la de
-- avance es la pose al volar (cambiable desde el dropdown de la ventana)
local FLY_ANIM = 10714177846   -- "Ud'zal's Summoning" (avanzar / strafe)
local BACK_ANIM = 10147823318   -- "BURBERRY LOLA ATTITUDE - HYDRO" (retroceder)
local IDLE_ANIM = 10714347256   -- "Godlike" (reposo)
local flyAnimId = FLY_ANIM
local flyAnimTime = 4.65

local lastDir = nil

local function dirOf(fwd, side)
	if fwd > 0.05 then return "forward" end
	if fwd < -0.05 then return "backward" end
	if side > 0.05 or side < -0.05 then return "strafe" end
	return "idle"
end

-- refresco por FRAME (no por evento): cubre las teclas retenidas al
-- activar y el thumbstick; solo re-juega si cambia la direccion
local function refreshAnim(fwd, side)
	local dir = dirOf(fwd, side)
	if dir == lastDir then return end
	lastDir = dir
	if dir == "forward" or dir == "strafe" then
		playAnimation(flyAnimId, flyAnimTime, 0)
	elseif dir == "backward" then
		playAnimation(BACK_ANIM, 4.11, 0)
	else
		playAnimation(IDLE_ANIM, 4, 0)
	end
end

local function flyInputBegan(input, processed)
	if processed then return end
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	local key = input.KeyCode
	if key == Enum.KeyCode.W then
		moveState.forward = 1
	elseif key == Enum.KeyCode.S then
		moveState.backward = 1
	elseif key == Enum.KeyCode.A then
		moveState.left = 1
	elseif key == Enum.KeyCode.D then
		moveState.right = 1
	end
end

local function flyInputEnded(input)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	local key = input.KeyCode
	if key == Enum.KeyCode.W then moveState.forward = 0
	elseif key == Enum.KeyCode.S then moveState.backward = 0
	elseif key == Enum.KeyCode.A then moveState.left = 0
	elseif key == Enum.KeyCode.D then moveState.right = 0
	end
end

-- Vector horizontal (Y=0): referencia para orientacion en reposo y para
-- el strafe lateral (A/D); la altura la da la mirada de la camara
local function flatDir(v)
	local f = Vector3.new(v.X, 0, v.Z)
	if f.Magnitude > 0.01 then return f.Unit end
	return nil
end

-- Fix shiftlock: guardar el cuello (Neck) para re-fijarlo cada frame;
-- si no, el personaje "no sabe hacia donde mirar" (la cabeza gira sola)
local headWeld = nil

local function lockHead()
	local head = character:FindFirstChild("Head")
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if not head or not torso then return end
	local neck = head:FindFirstChild("Neck") or torso:FindFirstChild("Neck")
	if neck and neck:IsA("Motor6D") then
		headWeld = { motor = neck, c0 = neck.C0, c1 = neck.C1 }
	end
end

local function unlockHead()
	if not headWeld then return end
	local m = headWeld.motor
	if m and m.Parent then
		m.C0 = headWeld.c0
		m.C1 = headWeld.c1
	end
	headWeld = nil
end

local function setFly(on)
	if flying == on then return end
	flying = on

	if on then
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		task.wait(0.1)

		Workspace.Gravity = 0
		humanoid.PlatformStand = true
		-- fix shiftlock: el personaje no debe rotar ni "irse como loco"
		-- en la direccion del movimiento mientras vuela
		humanoid.AutoRotate = false
		pcall(function()
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Running, false)
			humanoid:SetStateEnabled(Enum.HumanoidStateType.RunningNoPhysics, false)
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Landed, false)
		end)
		playAnimation(IDLE_ANIM, 4, 0)
		lastDir = "idle"

		local gyro = Instance.new("BodyGyro")
		gyro.Name = "FlyGyro"
		gyro.P = 90000
		gyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
		gyro.CFrame = hrp.CFrame
		gyro.Parent = hrp

		local bv = Instance.new("BodyVelocity")
		bv.Name = "FlyVelocity"
		bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
		bv.Velocity = Vector3.zero
		bv.Parent = hrp

		currentCF = nil
		currentVelocity = Vector3.zero
		-- entradas limpias al iniciar (no arrastrar estado anterior)
		moveState = emptyMove()
		-- fix shiftlock: capturar el cuello antes del primer frame
		lockHead()

		table.insert(flightConns, RunService.RenderStepped:Connect(function(dt)
			dt = dt or 1 / 60
			local cam = Workspace.CurrentCamera

			-- re-fuerzo por frame: shiftlock/respawn no deben reactivar
			-- la rotacion automatica ni soltar el PlatformStand
			if humanoid.AutoRotate then humanoid.AutoRotate = false end
			if not humanoid.PlatformStand then humanoid.PlatformStand = true end

			-- fix shiftlock: el cuello se re-fija cada frame (la cabeza
			-- no debe girar "sin saber hacia donde mirar")
			if headWeld then
				local m = headWeld.motor
				if m and m.Parent then
					m.C0 = headWeld.c0
					m.C1 = headWeld.c1
					m.CurrentAngle = 0
					m.DesiredAngle = 0
				end
			end

			local fwd = moveState.forward - moveState.backward
			local side = moveState.right - moveState.left
			if Controls then
				local moveVector = Controls:GetMoveVector()
				fwd = fwd - moveVector.Z
				side = side + moveVector.X
			end

			-- animacion por direccion (forward/backward/strafe/idle):
			-- se decide por frame y solo vuelve a jugar si cambia
			refreshAnim(fwd, side)

			-- la direccion de avance sigue la MIRADA de la camara con un
			-- muerto de DEAD_PITCH: por debajo de esa inclinacion la base
			-- es plana y NO hay derivo vertical (volar recto no sube ni
			-- baja); el strafe lateral (A/D) siempre es plano
			local camLook = cam.CFrame.LookVector
			local refFwd = flatDir(camLook) or Vector3.new(0, 0, -1)
			local refRight = flatDir(cam.CFrame.RightVector) or Vector3.new(1, 0, 0)
			local camPitch = math.deg(math.asin(math.clamp(camLook.Y, -1, 1)))
			local effPitch = 0
			if math.abs(camPitch) > DEAD_PITCH then
				local signPitch = camPitch > 0 and 1 or -1
				effPitch = math.rad(camPitch - signPitch * DEAD_PITCH)
			end
			local fwdDir = refFwd * math.cos(effPitch) + Vector3.new(0, 1, 0) * math.sin(effPitch)

			local inputVec = fwdDir * fwd + refRight * side
			local moving = inputVec.Magnitude > 0.01

			-- levitacion clavada (como la version original): en reposo la
			-- velocidad es 0 exacto (Gravity=0 la compensa); sin float
			-- ni ascenso inicial
			local desiredVelocity = Vector3.zero
			if moving then
				desiredVelocity = inputVec.Unit * flySpeed
			end

			local alpha = math.clamp(dt * (moving and 14 or 15), 0, 1)
			currentVelocity = currentVelocity:Lerp(desiredVelocity, alpha)
			if (currentVelocity - desiredVelocity).Magnitude < 0.05 then
				currentVelocity = desiredVelocity
			end
			bv.Velocity = currentVelocity

			-- orientacion: base plano + inclinaciones (superman / bancao
			-- lateral); al avanzar mirando arriba/abajo el cuerpo se
			-- inclina con la camara (la altura la marca la mirada)
			local forwardTilt = 0
			if fwd > 0.05 then
				forwardTilt = -90 + camPitch
			elseif fwd < -0.05 then
				forwardTilt = 45 + camPitch
			end
			local sideTilt = side * -45

			local baseCF = CFrame.lookAt(Vector3.zero, refFwd, Vector3.new(0, 1, 0))
			local desiredCF = baseCF * CFrame.Angles(math.rad(forwardTilt), 0, math.rad(sideTilt))
			if currentCF then
				currentCF = currentCF:Lerp(desiredCF, math.clamp(dt * 12, 0, 1))
			else
				currentCF = desiredCF
			end
			gyro.CFrame = currentCF
		end))

		table.insert(flightConns, UserInputService.InputBegan:Connect(flyInputBegan))
		table.insert(flightConns, UserInputService.InputEnded:Connect(flyInputEnded))
	else
		Workspace.Gravity = originalGravity
		humanoid.PlatformStand = false
		humanoid.AutoRotate = true
		pcall(function()
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Running, true)
			humanoid:SetStateEnabled(Enum.HumanoidStateType.RunningNoPhysics, true)
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Landed, true)
		end)
		stopAnimation()
		unlockHead()
		if hrp:FindFirstChild("FlyGyro") then hrp.FlyGyro:Destroy() end
		if hrp:FindFirstChild("FlyVelocity") then hrp.FlyVelocity:Destroy() end
		for _, conn in ipairs(flightConns) do
			if conn.Connected then conn:Disconnect() end
		end
		flightConns = {}
		moveState = emptyMove()
		lastDir = nil
	end
end

-- ============================================================
-- UI con LIBB (sin apartados: solo fly + velocidad)
-- ============================================================
local Lib = loadstring(game:HttpGet(
	"https://raw.githubusercontent.com/PrinceBeebear/FlowLib/main/LIBB.lua"
))()

Lib:Singleton("SflyUI")

local win = Lib:CreateWindow({
	title = "Superman Fly",
	width = 210,
	height = 190,
	keybind = Enum.KeyCode.RightControl,
	onClose = function()
		setFly(false)
	end,
})

-- bind inline a la izquierda del switch: la tecla alterna el fly (X)
local flyToggle = win:AddToggle({
	name = "Fly",
	keybind = Enum.KeyCode.X,
	default = false,
	callback = function(on)
		setFly(on)
	end,
})

win:AddSlider({
	name = "Velocidad",
	min = 10,
	max = 400,
	default = 120,
	callback = function(v)
		flySpeed = v
	end,
})

-- animaciones oficiales de Roblox (lote "Emote_*"): la lista vive en
-- este script (la lib solo aporta el componente desplegable) y elegir
-- una cambia la pose al volar hacia delante
local ANIMS = {
	{ id = 10714177846, name = "Ud'zal's Summoning", time = 4.65 },
	{ id = 10147823318, name = "BURBERRY LOLA ATTITUDE - HYDRO", time = 4.11 },
	{ id = 10714347256, name = "Godlike", time = 4 },
	{ id = 10714340543, name = "Floss Dance", time = 2 },
	{ id = 10714403700, name = "Rock On", time = 2 },
	{ id = 10714392151, name = "Robot", time = 2 },
	{ id = 10714389988, name = "Salute", time = 2 },
	{ id = 10714360164, name = "Hero Landing", time = 2 },
	{ id = 10714386947, name = "Samba", time = 2 },
	{ id = 10714369624, name = "Hype Dance", time = 2 },
}

local animDrop = win:AddDropdown({
	name = "Animacion",
	items = ANIMS,
	callback = function(item)
		flyAnimId = item.id
		local raw = item.raw
		flyAnimTime = (type(raw) == "table" and tonumber(raw.time)) or 2
		if flying then lastDir = nil end -- re-juega la pose en el proximo frame
	end,
})
animDrop.Set(flyAnimId)

player.CharacterAdded:Connect(function(newCharacter)
	if flying then setFly(false) end
	character = newCharacter
	humanoid = character:WaitForChild("Humanoid")
	hrp = character:WaitForChild("HumanoidRootPart")
	flyToggle.Set(false)
end)

return win
